# Copy to .env and adjust. .env is gitignored.
#
# Host ports differ from container ports: docker-compose publishes Postgres on 55432
# and Redis on 56379 to avoid colliding with local installs. These values are for
# running the backend on the host against the compose services.

ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://quorum:aryan@localhost:55432/quorum
REDIS_URL=redis://localhost:56379/0

# Phase 3. Without it the agent layer is disabled and the app logs agent_enabled=false
# at startup. Phase 1 needs no key.
# ANTHROPIC_API_KEY=sk-ant-...

# Fallback trust-gate thresholds, used only for a category with no trust_scores row.
# Live thresholds are per-category rows in Postgres.
DEFAULT_AUTO_APPLY_THRESHOLD=0.90
DEFAULT_REVIEW_THRESHOLD=0.60
DEFAULT_MIN_SAMPLE_SIZE=50
